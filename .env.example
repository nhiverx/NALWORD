# HITL Document Pipeline — Environment Variables
# ==============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- App ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-64-char-string

# --- Amazon Bedrock ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=  # only for temporary credentials / role assumption

# Bedrock model (Claude 3.5 Sonnet recommended for long-form writing)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.2

# --- LiteLLM proxy (optional; centralized request logging) ---
USE_LITELLM_PROXY=false
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_API_KEY=

# --- llama.cpp embedding server ---
LLAMA_CPP_SERVER_URL=http://localhost:8080
EMBEDDING_MODEL_PATH=./models/nomic-embed-text-v1.5.Q4_K_M.gguf
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32

# --- FAISS ---
FAISS_INDEX_PATH=data/faiss_index
FAISS_TOP_K=5

# --- PostgreSQL ---
DATABASE_URL=postgresql://hitl:hitl@localhost:5432/hitl_pipeline
DB_POOL_SIZE=10

# --- Knowledge base ---
KB_JSON_PATH=data/knowledge_base.json
KB_DOCUMENTS_DIR=data/documents

# --- Security / audit ---
AUDIT_LOG_PATH=logs/audit.jsonl
FEEDBACK_STORE_PATH=logs/feedback.jsonl
REQUIRE_HITL_APPROVAL=true
MAX_GENERATION_ATTEMPTS=5

# --- Content validation ---
ENABLE_CONTENT_VALIDATION=true
MAX_SOURCE_AGE_DAYS=1825
